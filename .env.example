# Local demo: `npm run demo` ignores this and needs no .env.local.
# Neon Postgres connection string (Singapore region)
DATABASE_URL=

# Ads and the support link stay off until these are set. Leave them empty until the Vercel plan allows commercial use.
# The ad network for the one ad slot. Only "adsense" is known.
AD_NETWORK=
# AdSense publisher ID (ca-pub-...) and the ID of a fixed-size 320x50 ad unit.
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Where "Support Yah Lah" goes: a Stripe payment link (https://buy.stripe.com/...).
SUPPORT_URL=
