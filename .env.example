# Local demo: `npm run demo` ignores this and needs no .env.local.
# Neon Postgres connection string (Singapore region)
DATABASE_URL=

# Ads and the support link stay off until these are set. Leave them empty until the Vercel plan allows commercial use.
# The ad network for the one ad slot. Only "adsense" is known.
AD_NETWORK=
# AdSense publisher ID (ca-pub-...) and the ID of a fixed-size 320x50 ad unit.
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Where "Support Yah Lah" goes: a Stripe payment link (https://buy.stripe.com/...).
SUPPORT_URL=

# Singpass login (see README, "Connecting Singpass"). Logging in is offered once SINGPASS_CLIENT_ID is
# set; set all four together, or the app refuses to start and says which is missing.
# The App ID from the Singpass Developer Portal.
SINGPASS_CLIENT_ID=
# "staging" or "production".
SINGPASS_ENVIRONMENT=
# This deployment's callback, exactly as registered with Singpass, e.g. https://sg-pulse.vercel.app/auth/singpass/callback
SINGPASS_REDIRECT_URI=
# The private keys, from `npm run singpass:keys`. Never commit or share these.
SINGPASS_PRIVATE_JWKS=
